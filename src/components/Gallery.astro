---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = Object.entries(
  import.meta.glob("/src/assets/img/tattoos/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,WEBP}", {
    eager: true,
    import: "default",
  }),
) as [string, ImageMetadata][];
---

<section id="galeria" class="px-16 py-5">
  <h2 data-aos="fade-up" class="text-center text-[3em] font-bold text-black">
    Galería
  </h2>
  <div class="mt-8 columns-1 gap-x-5 sm:columns-2 md:columns-3 lg:columns-4">
    {
      images.map(([imagePath, image]) => (
        <Image
          src={image}
          alt={`Tatuaje de ${imagePath.split("/").pop()?.split(".")[0]}`}
          data-aos="zoom-in"
          class="mb-5 block h-auto w-full break-inside-avoid rounded-[10px] hover:scale-105"
        />
      ))
    }
  </div>
</section>
