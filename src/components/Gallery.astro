---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = Object.entries(
  import.meta.glob("/src/assets/img/tattoos/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,WEBP}", {
    eager: true,
    import: "default",
  }),
) as [string, ImageMetadata][];
---

<section id="galeria" class="py-12 px-4">
  <div class="mx-auto max-w-7xl">
    <!-- Cabecera centrada estilo Haircut -->
    <div class="mx-auto mb-12 max-w-[600px] text-center" data-aos="fade-up">
      <p class="inline-block bg-ink px-4 py-1 font-display text-base uppercase tracking-wider text-brand">
        Galería
      </p>
      <h1 class="mt-4 font-display text-4xl font-semibold uppercase leading-[1.2] text-white md:text-5xl">
        Mis trabajos
      </h1>
    </div>

    <div class="columns-1 gap-x-5 sm:columns-2 md:columns-3 lg:columns-4">
      {
        images.map(([imagePath, image]) => (
          <Image
            src={image}
            alt={`Tatuaje de ${imagePath.split("/").pop()?.split(".")[0]}`}
            data-aos="zoom-in"
            class="mb-5 block h-auto w-full break-inside-avoid transition-transform duration-300 hover:scale-105"
          />
        ))
      }
    </div>
  </div>
</section>
