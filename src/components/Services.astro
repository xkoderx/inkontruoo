---
const services = [
  {
    title: "Fineline",
    description:
      "Líneas finas y delicadas, con precisión milimétrica para diseños minimalistas y llenos de detalle.",
    delay: 0,
    icon: '<path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" /><line x1="16" y1="8" x2="2" y2="22" /><line x1="17.5" y1="15" x2="9" y2="15" />',
  },
  {
    title: "Geométrico",
    description:
      "Formas, patrones y simetría que convierten la piel en geometría perfecta.",
    delay: 100,
    icon: '<polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" />',
  },
  {
    title: "Realismo",
    description:
      "Retratos y piezas con sombras y detalle que parecen fotografías en la piel.",
    delay: 200,
    icon: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />',
  },
  {
    title: "Diseños personalizados",
    description:
      "Cada diseño es una colaboración íntima con el cliente, buscando plasmar historias en la piel.",
    delay: 300,
    icon: '<path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5z" />',
  },
];
---

<section id="servicios" class="py-12">
  <div class="mx-auto max-w-7xl px-4 lg:px-5">
    <!-- Cabecera centrada estilo Haircut -->
    <div class="mx-auto mb-12 max-w-[600px] text-center" data-aos="fade-up">
      <p class="inline-block bg-ink px-4 py-1 font-display text-base uppercase tracking-wider text-brand">
        Servicios
      </p>
      <h1 class="mt-4 font-display text-4xl font-semibold uppercase leading-[1.2] text-white md:text-5xl">
        Lo que hago
      </h1>
    </div>

    <!-- Tarjetas estilo Haircut -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article
            class="group relative flex h-full overflow-hidden bg-ink p-12 pl-0"
            data-aos="fade-up"
            data-aos-delay={service.delay}
          >
            <div class="flex h-[60px] w-[60px] shrink-0 items-center justify-center bg-black text-brand">
              <svg
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={service.icon}
              />
            </div>
            <div class="pl-6">
              <h3 class="mb-3 font-display text-[1.75rem] uppercase leading-[1.2] text-white">
                {service.title}
              </h3>
              <p class="text-smoke">{service.description}</p>
              <a
                href="#galeria"
                class="mt-4 inline-block font-display text-base uppercase tracking-wide text-brand transition-colors hover:text-white"
              >
                Ver trabajos &rarr;
              </a>
            </div>
            <a
              href="#galeria"
              aria-label={`Ver trabajos de ${service.title}`}
              class="absolute -bottom-[50px] -right-[50px] flex h-[50px] w-[50px] items-center justify-center bg-black text-xl text-brand opacity-0 transition-all duration-500 group-hover:bottom-0 group-hover:right-0 group-hover:opacity-100"
            >
              +
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
