---
const year = new Date().getFullYear();
const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#servicios", label: "Servicios" },
  { href: "#galeria", label: "Galería" },
  { href: "#contacto", label: "Contacto" },
];
---

<footer class="mt-12 bg-ink pt-12 text-[#f8f9fa]">
  <div class="mx-auto px-4 py-12">
    <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-2 lg:grid-cols-3">
      <!-- Contacto -->
      <div>
        <h4 class="mb-4 font-display text-2xl uppercase text-white">Contacto</h4>
        <div class="mb-2 flex items-center">
          <span class="mr-3 flex h-[38px] w-[38px] shrink-0 items-center justify-center bg-black text-brand">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-10 6L2 7" />
            </svg>
          </span>
          <a href="mailto:erickmichele@outlook.com" class="break-all text-smoke transition-colors hover:text-brand">
            erickmichele@outlook.com
          </a>
        </div>
        <div class="mb-2 flex items-center">
          <span class="mr-3 flex h-[38px] w-[38px] shrink-0 items-center justify-center bg-black text-brand">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
          </span>
          <a href="#contacto" class="text-smoke transition-colors hover:text-brand">
            Agenda tu cita
          </a>
        </div>
      </div>

      <!-- Enlaces rápidos -->
      <div>
        <h4 class="mb-4 font-display text-2xl uppercase text-white">Enlaces</h4>
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mb-[5px] block text-[15px] capitalize text-smoke transition-all duration-300 hover:text-brand hover:tracking-[1px]"
            >
              <span class="mr-[10px]" aria-hidden="true">&rsaquo;</span>
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- Redes sociales -->
      <div>
        <h4 class="mb-4 font-display text-2xl uppercase text-white">Síguenos</h4>
        <p class="mb-4 text-sm text-smoke">
          Síguenos en Instagram y escríbenos por WhatsApp para cotizar tu diseño.
        </p>
        <div class="flex gap-2">
          <a
            href="https://instagram.com/inkontruoo"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Inkontruoo"
            title="Instagram — @inkontruoo"
            class="flex h-12 w-12 items-center justify-center bg-black text-brand transition-colors hover:bg-brand hover:text-white"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
            </svg>
          </a>
          <a
            href="https://wa.me/525615151624"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de Inkontruoo"
            title="WhatsApp — 56 1515 1624"
            class="flex h-12 w-12 items-center justify-center bg-black text-brand transition-colors hover:bg-brand hover:text-white"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright + créditos de plantillas (licencias CC BY: deben conservarse) -->
  <div class="bg-black px-4 py-6 text-[15px]">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {year} Inkontruoo. Todos los derechos reservados. Sitio por
        <a href="https://github.com/xkoderx" class="font-bold text-smoke transition-colors hover:text-brand"> xkoderx</a>.
      </p>
      <p class="text-smoke">
        Diseño: HairCut de
        <a href="https://htmlcodex.com" class="transition-colors hover:text-brand">HTML Codex</a>
        &middot; Galería Instagram: Alime de
        <a href="https://colorlib.com" class="transition-colors hover:text-brand">Colorlib</a>
      </p>
    </div>
  </div>

  <!-- Volver arriba (estilo Haircut) -->
  <button
    id="backToTop"
    aria-label="Volver arriba"
    class="fixed bottom-[45px] right-[45px] z-[99] hidden h-12 w-12 items-center justify-center bg-brand text-white transition-colors hover:bg-[#c81212]"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m18 15-6-6-6 6" />
    </svg>
  </button>
</footer>

<script is:client>
  const backToTop = document.getElementById("backToTop");
  const onScrollTop = () => {
    const show = window.scrollY > 300;
    backToTop?.classList.toggle("hidden", !show);
    backToTop?.classList.toggle("flex", show);
  };
  window.addEventListener("scroll", onScrollTop);
  onScrollTop();
  backToTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
