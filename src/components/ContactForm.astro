---
// No necesitas lógica aquí a menos que manejes el envío con JavaScript o API
---

<section id="contacto" class="max-w-xl mx-auto mt-16 px-6" data-aos="fade-up">
  <h2
    class="text-2xl font-semibold text-center mb-6 text-black dark:text-white"
  >
    Agenda una cita
  </h2>
  <form
    action="mailto:erickmichele@outlook.com"
    method="POST"
    class="space-y-4 bg-white p-6 rounded-lg shadow-md"
  >
    <input
      type="text"
      name="nombre"
      placeholder="Tu nombre"
      required
      class="w-full text-black px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <input
      type="email"
      name="email"
      placeholder="Tu correo electrónico"
      required
      class="w-full text-black px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <textarea
      name="mensaje"
      placeholder="Escribe tu mensaje..."
      rows="5"
      required
      class="w-full text-black px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
    ></textarea>
    <button
      type="submit"
      class="w-full bg-gray-900 text-white py-2 rounded-md hover:bg-black transition-colors"
    >
      Enviar
    </button>
  </form>
</section>
