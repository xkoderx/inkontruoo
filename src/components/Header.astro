---
import Darktheme from "./Darktheme.astro";
---
<header class="fixed top-0 left-0 w-full z-50">
  <!-- Fondo dinámico -->
  <div id="header-bg" class="h-18 transition-all duration-300"></div>

  <!-- Contenido fijo -->
  <div class="fixed top-0 left-0 w-full">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <!-- Contenedor del logo -->
      <div class="relative h-10 w-32">
        <!-- Logo principal (visible al inicio) -->
        <div
          id="logo-main"
          class="absolute inset-0 flex items-center justify-start transition-opacity duration-300 opacity-100 gap-6"
        >
          <img src="logo-header.png" alt="Ink Icon" class="h-12" />
          <a class="text-l truncate font-bold text-black dark:text-white"
            >Tattoo Studio </a
          >
        </div>

        <!-- Logo alternativo (visible al hacer scroll) -->
        <div
          id="logo-alt"
          class="absolute inset-0 flex items-center justify-start transition-opacity duration-300 opacity-0"
        >
          <img src="favicon.ico" alt="Ink Icon" class="h-12" />
        </div>
      </div>

      <!-- Navegación -->
      <nav class="hidden md:flex space-x-6">
        <a
          href="#inicio"
          class="font-bold text-black dark:text-white hover:underline">Inicio</a
        >
        <a
          href="#sobre-mi"
          class="font-bold text-black dark:text-white hover:underline"
          >Sobre mí</a
        >
        <a
          href="#galeria"
          class="font-bold text-black dark:text-white hover:underline"
          >Galería</a
        >
        <a
          href="#contacto"
          class="font-bold text-black dark:text-white hover:underline"
          >Contacto</a
        >
      </nav>
      <Darktheme/>
    </div>
  </div>
</header>
<script is:client>
  const headerBg = document.getElementById("header-bg");
  let lastScroll = 0;

  const setHeaderStyle = (scrollY) => {
    if (scrollY <= 10) {
      // Parte superior: fondo sólido según tema
      headerBg.className =
        "h-16 transition-all duration-300 bg-white dark:bg-black";
    } else {
      // Scroll hacia abajo: fondo transparente con desenfoque
      headerBg.className =
        "h-16 transition-all duration-300 bg-white/60 dark:bg-black/60 backdrop-blur-md shadow-md";
    }
  };

  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    setHeaderStyle(scrollY);
    lastScroll = scrollY;
  });

  // Inicializa al cargar
  setHeaderStyle(window.scrollY);
</script>
<script is:client>
  const logoMain = document.getElementById("logo-main");
  const logoAlt = document.getElementById("logo-alt");

  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;

    if (scrollY > 50) {
      logoMain.classList.add("opacity-0");
      logoMain.classList.remove("opacity-100");
      logoAlt.classList.add("opacity-100");
      logoAlt.classList.remove("opacity-0");
    } else {
      logoMain.classList.add("opacity-100");
      logoMain.classList.remove("opacity-0");
      logoAlt.classList.add("opacity-0");
      logoAlt.classList.remove("opacity-100");
    }
  });
</script>
