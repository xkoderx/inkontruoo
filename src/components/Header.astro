---
const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#servicios", label: "Servicios" },
  { href: "#galeria", label: "Galería" },
  { href: "#contacto", label: "Contacto" },
];
---

<header id="site-header" class="fixed left-0 top-0 z-50 w-full bg-ink transition-shadow duration-300">
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 lg:px-5">
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-3">
      <img src="logo-header.png" alt="Inkontruoo" class="h-10" />
      <span class="font-display text-lg uppercase tracking-widest text-white">Tattoo Studio</span>
    </a>

    <!-- Navegación escritorio -->
    <nav class="hidden items-center lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mr-[30px] font-display text-[18px] font-semibold uppercase text-smoke transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        class="hidden bg-brand px-6 py-2.5 font-display text-base font-semibold uppercase tracking-wide text-white transition-colors hover:bg-[#c81212] lg:inline-flex lg:items-center"
      >
        Agenda tu cita
        <span class="ml-3" aria-hidden="true">&rarr;</span>
      </a>
    </nav>

    <!-- Hamburguesa móvil -->
    <button
      id="hamburger"
      class="flex flex-col justify-center gap-1.5 p-2 lg:hidden"
      aria-label="Abrir menú"
      onclick="toggleMenu()"
    >
      <span class="block h-0.5 w-6 bg-white"></span>
      <span class="block h-0.5 w-6 bg-white"></span>
      <span class="block h-0.5 w-6 bg-white"></span>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobileMenu" class="hidden border-t border-white/10 bg-ink shadow-md lg:hidden">
    <nav class="flex flex-col px-4 py-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            onclick="toggleMenu()"
            class="py-3 text-center font-display text-lg font-semibold uppercase text-white transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contacto"
        onclick="toggleMenu()"
        class="mx-auto my-2 bg-brand px-6 py-2.5 font-display text-base font-semibold uppercase tracking-wide text-white"
      >
        Agenda tu cita
      </a>
    </nav>
  </div>
</header>

<script is:client>
  const header = document.getElementById("site-header");
  const onScroll = () => {
    header?.classList.toggle("shadow-lg", window.scrollY > 10);
  };
  window.addEventListener("scroll", onScroll);
  onScroll();

  window.toggleMenu = () => {
    document.getElementById("mobileMenu")?.classList.toggle("hidden");
  };
</script>
