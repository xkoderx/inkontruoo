---
import "../styles/global.css";
import "aos/dist/aos.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Inkontruoo Tattoo Studio — Arte que deja huella. Tatuajes fineline, geométricos y realismo con más de 5 años de experiencia."
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon" />
    <title>Inkontruoo | Tattoo Studio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@600&family=Roboto:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black font-sans text-white antialiased">
    <slot />
    <script>
      import AOS from "aos";
      AOS.init({ once: false, duration: 800 });
    </script>
  </body>
</html>
